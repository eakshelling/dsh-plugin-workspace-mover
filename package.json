{
  "name": "dsh-plugin-workspace-mover",
  "version": "1.0.0",
  "type": "module",
  "description": "Move a Session between Workspaces: right-click a session, queue the move, applied on the next DSH start.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "assets",
    "screenshots.json",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  },
  "license": "MIT",
  "author": "eakshelling",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eakshelling/dsh-plugin-workspace-mover.git"
  },
  "homepage": "https://github.com/eakshelling/dsh-plugin-workspace-mover#readme",
  "bugs": {
    "url": "https://github.com/eakshelling/dsh-plugin-workspace-mover/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "session",
    "workspace",
    "move"
  ],
  "publishConfig": {
    "access": "public"
  }
}
